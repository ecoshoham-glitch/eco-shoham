# קודי ה-QR הפיזיים הקיימים (מודפסים על המוצרים, אי אפשר להחליף) מצביעים
# לשורש הדומיין עם ?aa=xxx/?sequence=xxx (מהתקופה שבה אפליקציית המולקולות
# ישבה בשורש עצמו) — לא ל-/molecules/. בלי הכללים האלה, הסריקה הייתה
# פוגעת באתר ה-React הראשי (שלא יודע לפרש ?aa=/?sequence= בכלל) במקום
# לפתוח את המולקולה ב-AR. חייבים לבוא *לפני* כלל ה-SPA הכללי למטה, ולתפוס
# רק כשיש בפועל query param תואם — פנייה רגילה ל-/ (בלי query) לא מושפעת,
# ממשיכה להציג את עמוד הבית הרגיל של האתר.
/  aa=:aa               /molecules/?aa=:aa               302
/  sequence=:sequence   /molecules/?sequence=:sequence   302

# פרויקט המולקולות (public/molecules/, אתר סטטי עצמאי, לא route של React
# Router) — חייב לבוא *לפני* כלל ה-SPA הכללי למטה, אחרת /molecules/?aa=gly
# וכל נתיב אחר תחת /molecules/ שאינו קובץ סטטי קיים היו מקבלים בטעות את
# index.html הראשי של האתר. קבצים סטטיים אמיתיים (glb/usdz/js/css שקיימים
# בפועל בפלט הבנייה תחת /molecules/) מוגשים ישירות ע"י Netlify ולא מגיעים
# לכלל הזה בכלל — הוא רק "רשת ביטחון" לכל נתיב תחת /molecules/ שאינו קובץ.
/molecules/*  /molecules/index.html  200

